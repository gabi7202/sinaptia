# ═══════════════════════════════════════════════════════════════════
#  SINAPTIA · Variables del backend de voz (fusión A+B)
#  Copia este archivo como referencia; las variables reales van en:
#    · Vercel → Settings → Environment Variables  (producción)
#    · vercel dev --env .env.local               (desarrollo local)
#  NUNCA subas claves reales a git (.env* está en .gitignore).
# ═══════════════════════════════════════════════════════════════════

# ── Vercel KV (memoria de clientes, sesiones y transcripciones) ──
# Supabase quedó ELIMINADO del proyecto. En Vercel → Storage → Create Database
# → "KV" (1 GB gratis). Al linkear la base, Vercel inyecta solas las variables
# con el nombre de la base: p. ej. si la llamas "voz" tendrás VOZ_REST_API_URL
# y VOZ_REST_API_TOKEN — el backend (server/kv.js) acepta cualquier prefijo
# *_REST_API_URL/*_REST_API_TOKEN, o el nombre fijo KKV_* si lo pones a mano.
KKV_REST_API_URL=https://x.upstash.io     # o VOZ_REST_API_URL=... (ambas valen)
KKV_REST_API_TOKEN=...                    # SOLO servidor (nunca en el frontend)

# ── Google Gemini (el cerebro conversacional, free tier de AI Studio) ──
GEMINI_API_KEY=...                     # aistudio.google.com → Get API key
CHAT_MODEL=gemini-2.5-flash         # opcional: modelo de conversación
EXTRACT_MODEL=gemini-2.5-flash      # opcional: modelo del resumen a lead
GEMINI_THINKING=0                      # opcional: 0 = latencia de voz (recomendado, familia 2.5)
# GEMINI_LEVEL=low                     # solo familia 3.x (sustituye a GEMINI_THINKING):
#                                      # minimal|low|medium|high — Google retira 2.5 el 2026-10-20,
#                                      # el salto es CHAT_MODEL=gemini-3.5-flash + GEMINI_LEVEL=low
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta  # opcional

# ── Alternativa: Groq (API OpenAI-compatible, muy rápida, free tier) ──
# Para forzarlo: pon LLM_PROVIDER=groq (o borra/quita GEMINI_API_KEY: la
# prioridad automática es gemini → groq → grok según la clave presente).
# GROQ_API_KEY=gsk_...                 # console.groq.com → API Keys
# CHAT_MODEL=openai/gpt-oss-120b        # opcional: conversación (default verificado en la cuenta)
# EXTRACT_MODEL=openai/gpt-oss-20b      # opcional: resumen a lead (default verificado)
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions   # opcional

# ── Alternativa: xAI / Grok (si hay XAI_API_KEY y NO GEMINI_API_KEY/GROQ_API_KEY, o LLM_PROVIDER=grok) ──
# XAI_API_KEY=xai-...                  # console.x.ai → API Keys
# GROK_EFFORT=low                      # opcional: low (voz, rápido) | medium | high
# LLM_PROVIDER=gemini                  # opcional: fuerza proveedor (gemini | groq | grok)

# ── Operación ──
CRON_SECRET=cambia-esto-por-un-secreto-largo   # Vercel Cron lo usa en /api/voz/cron
PANEL_SECRET=otra-clave-larga-distinta         # protege /api/voz/panel (analítica)

# ── Opcionales del proxy anterior (infra/worker-ia.js / api/ia.js) ──
# OPENAI_KEY=
# GROK_MODEL=grok-4.7
# GEMINI_MODEL=gemini-2.5-flash
# ORIGEN_PERMITIDO=https://tu-dominio.com
