# ═══════════════════════════════════════════════════════════════════
#  SINAPTIA · Variables del backend de voz (fusión A+B)
#  Copia este archivo como referencia; las variables reales van en:
#    · Vercel → Settings → Environment Variables  (producción)
#    · vercel dev --env .env.local               (desarrollo local)
#  NUNCA subas claves reales a git (.env* está en .gitignore).
# ═══════════════════════════════════════════════════════════════════

# ── Supabase (memoria de clientes y transcripciones) ──
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=eyJ...            # service_role: SOLO servidor

# ── xAI / Grok (el cerebro conversacional) ──
XAI_API_KEY=xai-...                    # console.x.ai → API Keys
CHAT_MODEL=grok-4.7                    # opcional: modelo de conversación
EXTRACT_MODEL=grok-4.7                 # opcional: modelo del resumen a lead
GROK_EFFORT=low                        # opcional: low (voz, rápido) | medium | high
# XAI_BASE_URL=https://api.x.ai/v1/chat/completions   # opcional: solo si cambias de puerta

# ── Operación ──
CRON_SECRET=cambia-esto-por-un-secreto-largo   # Vercel Cron lo usa en /api/voz/cron
PANEL_SECRET=otra-clave-larga-distinta         # protege /api/voz/panel (analítica)

# ── Opcionales del proxy anterior (infra/worker-ia.js / api/ia.js) ──
# OPENAI_KEY=
# GROK_MODEL=grok-4.7
# ORIGEN_PERMITIDO=https://tu-dominio.com
