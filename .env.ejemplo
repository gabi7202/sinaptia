# ═══════════════════════════════════════════════════════════════════
#  SINAPTIA · Variables de entorno (limpias, octubre 2026)
#  Copia este archivo como referencia; las variables reales van en:
#    · Vercel → Settings → Environment Variables
#    · vercel env pull .env.local + npm run env:check
#  NUNCA subas claves reales a git (.env* está en .gitignore).
#  El correo privado NO se escribe aquí ni en el cliente: solo LEAD_EMAIL.
# ═══════════════════════════════════════════════════════════════════

# ── Groq (ÚNICO proveedor necesario) ──
# console.groq.com → API Keys. Con esta clave el chat y la voz ya usan IA.
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EXTRACT_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.5

# ── Copia del brief por Gmail (Google Apps Script) ──
# Sigue google-apps-script/README.md. El correo del dueño va en las propiedades
# del script (LEAD_EMAIL) o se usa la cuenta que lo despliega. Nunca en el HTML.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfy.../exec
GOOGLE_SCRIPT_TOKEN=una-cadena-larga-y-aleatoria

# ── Email de respaldo (opcional; si no usas Google Apps Script) ──
# LEAD_EMAIL=tu-correo-privado
# RESEND_API_KEY=re_...
# RESEND_FROM=Sinaptia <hola@tudominio.com>

# ── Webhook genérico de respaldo (opcional) ──
# PROYECTO_WEBHOOK=https://tu-n8n.tudominio.com/webhook/sinaptia-brief

# ── Supabase (opcional): memoria de clientes, transcripciones y proyectos ──
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...            # service_role: SOLO servidor

# ── Operación ──
CRON_SECRET=cambia-esto-por-un-secreto-largo
PANEL_SECRET=otra-clave-larga-distinta
ORIGEN_PERMITIDO=https://tu-dominio.com

# ── Build del sitio (Vercel → Environment Variables, o .env al compilar) ──
# PUBLIC_IA_ENDPOINT=/api/ia        # por defecto; 'off' = 100% local
# PUBLIC_IA_VOZ=/api/voz            # streaming + memoria de servidor en /voz
# PUBLIC_PROYECTO_ENDPOINT=/api/proyecto
# PUBLIC_PROYECTO_AUTO=0            # desactiva el envío automático
# PUBLIC_FUNDADOR=Rafael Ortiz
# PUBLIC_IDIOMA=en                  # fuerza idioma por defecto ('es'|'en'|'pt')

# ── OBSOLETAS: bórralas si solo usas Groq ──
# XAI_API_KEY · GROK_API_KEY · GROK_MODEL · XAI_MODEL · XAI_BASE_URL
# GROK_EFFORT · CHAT_MODEL · EXTRACT_MODEL
# OPENAI_KEY · OPENAI_MODEL · OPENAI_EXTRACT_MODEL
# GROK_EXTRACT_MODEL · XAI_EXTRACT_MODEL
# El código las acepta como respaldo, pero no las necesitas. `npm run env:check`
# las lista y `curl https://tu-dominio.com/api/ia` también.
