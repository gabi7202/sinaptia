# ═══════════════════════════════════════════════════════════════════
#  SINAPTIA · Variables del backend de voz — SOLO GROQ
#  Gemini y Grok/xAI quedaron ELIMINADOS del proyecto.
#  Copia este archivo como referencia; las variables reales van en:
#    · Vercel → Settings → Environment Variables  (producción)
#    · vercel dev --env .env.local               (desarrollo local)
#  NUNCA subas claves reales a git (.env está en .gitignore;
#  GitHub Push Protection bloquea el push si detecta una gsk_...).
#  Regla: tras cambiar env vars en Vercel → Redeploy obligatorio.
# ═══════════════════════════════════════════════════════════════════

# ── IA: Groq (único proveedor — API compatible con OpenAI) ──
GROQ_API_KEY=gsk_pegar-aqui            # console.groq.com → API Keys
CHAT_MODEL=openai/gpt-oss-120b         # opcional: conversación (default verificado)
EXTRACT_MODEL=openai/gpt-oss-20b       # opcional: resumen → lead (default verificado)
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions   # opcional

# ── Vercel KV (memoria de clientes, sesiones y transcripciones) ──
# Supabase quedó ELIMINADO. En Vercel → Storage → Create Database → "KV".
# Al linkear la base, Vercel inyecta solas las variables con el nombre de
# la base: p. ej. si la llamas "voz" tendrás VOZ_REST_API_URL /
# VOZ_REST_API_TOKEN — server/kv.js acepta cualquier prefijo
# *_REST_API_URL/*_REST_API_TOKEN, o el nombre fijo KKV_* a mano.
KKV_REST_API_URL=https://x.upstash.io  # o VOZ_REST_API_URL=... (ambas valen)
KKV_REST_API_TOKEN=...                 # SOLO servidor (nunca en el frontend)

# ── Operación ──
CRON_SECRET=cambia-esto-por-un-secreto-largo   # Vercel Cron lo usa en /api/voz/cron
PANEL_SECRET=otra-clave-larga-distinta         # protege /api/voz/panel (analítica)
