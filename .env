# ═══════════════════════════════════════════════════════════════════
#  SINAPTIA · .env — variables del backend de voz (SOLO Groq)
#  Este archivo NUNCA se sube a git (.gitignore lo excluye: .env).
#  Réplicalo tal cual en Vercel → Settings → Environment Variables.
#  Regla: tras cambiar algo aquí o en Vercel → Redeploy obligatorio.
# ═══════════════════════════════════════════════════════════════════

# ── IA: Groq (único proveedor — Gemini y Grok/xAI eliminados) ──────────────
# Pega aquí tu clave real (console.groq.com → API Keys). NUNCA la subas a git.
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b        # conversación (verificado en el catálogo real)
EXTRACT_MODEL=openai/gpt-oss-20b      # resumen → lead
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions   # opcional

# ── Persistencia: Vercel KV (Supabase ELIMINADO) ───────────────────────────
# Crea la base en Vercel → Storage → Create Database → KV. Al linkearla,
# Vercel inyecta solas las variables con el nombre de la base (p. ej. si la
# llamas "voz": VOZ_REST_API_URL / VOZ_REST_API_TOKEN). server/kv.js acepta
# cualquier prefijo *_REST_API_*; KKV_* es el nombre fijo alternativo.
KKV_REST_API_URL=                     # p. ej. https://x.upstash.io
KKV_REST_API_TOKEN=                   # SOLO servidor (nunca en el frontend)

# ── Operación ───────────────────────────────────────────────────────────────
CRON_SECRET=cambia-esto-por-un-secreto-largo   # lo usa /api/voz/cron (Vercel Cron)
PANEL_SECRET=otra-clave-larga-distinta         # protege /api/voz/panel (analítica)
