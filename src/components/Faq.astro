---
/**
 * Faq.astro — Objeciones reales del comprador, respondidas sin rodeos.
 * El contenido vive en src/lib/faq.js porque el mismo texto alimenta el
 * JSON-LD FAQPage de la home (una fuente, dos salidas).
 */
import { FAQ } from '../lib/faq.js';
---
<section id="faq">
  <div class="wrap wrap-narrow">
    <div class="sec-head" style="text-align:center;margin-left:auto;margin-right:auto">
      <h2>Lo que suelen preguntarnos</h2>
    </div>
    <div class="faq">
      {FAQ.map(({ q, a, abierta }) => (
        <details open={abierta || undefined}><summary>{q}</summary><p>{a}</p></details>
      ))}
    </div>
  </div>
</section>
