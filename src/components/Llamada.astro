<div class="llamada" id="llamada" data-estado="inactiva" role="dialog" aria-label="Llamada de voz con el agente" aria-hidden="true">
  <div class="ll-inner">
    <div class="ll-orb" aria-hidden="true">
      <span class="ring r1"></span><span class="ring r2"></span><span class="ring r3"></span>
      <span class="core">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/>
          <path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4"/>
        </svg>
      </span>
    </div>
    <div class="ll-estado" id="ll-estado">conectando…</div>
    <div class="ll-transcripcion" id="ll-transcripcion">…</div>
    <div class="ll-respuesta" id="ll-respuesta"></div>
    <div class="ll-aviso" id="ll-aviso"></div>
    <button class="ll-tap" id="ll-tap" hidden>Toca para hablar</button>
    <div class="ll-controles">
      <button class="ll-btn" id="ll-mic" title="Pausar o reanudar la escucha">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4"/></svg>
        <span id="ll-mic-txt">pausar</span>
      </button>
      <button class="ll-btn colgar" id="ll-colgar" title="Colgar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg>
        <span>colgar</span>
      </button>
      <button class="ll-btn" id="ll-silencio" title="Silenciar la voz de la IA">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M23 9l-6 6M17 9l6 6"/></svg>
        <span id="ll-sil-txt">silenciar</span>
      </button>
    </div>
    <p class="ll-priv">La conversación se procesa en tu navegador y en los servidores de voz de tu
      sistema operativo. Nada de lo que digas se envía a nuestro servidor.</p>
  </div>
</div>
