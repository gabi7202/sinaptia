---
import { CONFIG } from '../config.js';
const NOMBRE = 'Yunior Rafael Ortiz Carela';
const LINKEDIN = 'https://www.linkedin.com/in/yunior-rafael-ortiz-carela';
---
<nav class="nav">
  <div class="nav-in">
    <a class="brand" href="#">
      <svg width="26" height="26" viewBox="0 0 40 40" aria-hidden="true">
        <g transform="translate(20,21)">
          <path d="M0 0 L-11 -11" stroke="#1450A3" stroke-width="3.4" stroke-linecap="round"/>
          <path d="M0 0 L12 -9" stroke="#1450A3" stroke-width="3.4" stroke-linecap="round"/>
          <path d="M0 0 L0 12" stroke="#1D6FE0" stroke-width="3.4" stroke-linecap="round"/>
          <circle cx="-11" cy="-11" r="3.4" fill="#1450A3"/><circle cx="12" cy="-9" r="3.4" fill="#1450A3"/>
          <circle cx="0" cy="12" r="3.8" fill="#1D6FE0"/><circle cx="0" cy="0" r="6.4" fill="#1D6FE0"/>
          <circle cx="0" cy="0" r="2.3" fill="#F4F7F9"/>
        </g>
      </svg>
      <span>{CONFIG.marca.nombre}</span>
    </a>
    <div class="nav-id" id="nav-id" role="group" aria-label="Idioma"></div>
    <div class="nav-live resolviendo" id="nav-live"><i></i><span id="nav-live-txt">resolviendo tu contexto…</span></div>
    <a class="nav-link" href="#auditoria">Auditoría gratis</a>
    <button class="nav-cta" id="nav-agente">Hablar con el agente</button>
    <div class="nav-perfil">
      <a class="nav-foto" href={LINKEDIN} target="_blank" rel="noopener me" aria-label={`LinkedIn de ${NOMBRE}`}>
        <img src="/perfil.png" alt={`Foto de ${NOMBRE}`} width="40" height="40" />
      </a>
      <div class="nav-perfil-txt">
        <span class="nav-nombre">{NOMBRE}</span>
        <span class="nav-ubic">{CONFIG.marca.ubicacion}</span>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-perfil{display:flex;align-items:center;gap:10px;margin-left:6px;padding-left:14px;border-left:1px solid var(--borde)}
  .nav-foto img{width:40px;height:40px;border-radius:50%;object-fit:cover;display:block;
    border:2px solid var(--azul-borde);box-shadow:0 0 0 3px var(--azul-suave);transition:.15s}
  .nav-foto:hover img{border-color:var(--azul);transform:translateY(-1px)}
  .nav-perfil-txt{display:flex;flex-direction:column;line-height:1.25}
  .nav-nombre{font-size:12.5px;font-weight:700;color:var(--tinta);letter-spacing:-.01em}
  .nav-ubic{font-family:var(--mono);font-size:9.5px;letter-spacing:.05em;color:var(--tinta3);text-transform:uppercase}
  @media (max-width:1080px){
    .nav-perfil{margin-left:0;padding-left:0;border-left:none}
    .nav-perfil-txt{display:none}
  }
</style>
