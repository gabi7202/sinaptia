---
import { SKILL } from '../lib/skill.js';
---
<div class="dock">
  <div class="panel" id="panel" role="dialog" aria-label="Conversación con el agente">
    <div class="p-head">
      <div class="av">
        <svg width="18" height="18" viewBox="0 0 40 40" aria-hidden="true">
          <g transform="translate(20,21)">
            <path d="M0 0 L-11 -11" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/>
            <path d="M0 0 L12 -9" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/>
            <path d="M0 0 L0 12" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/>
            <circle cx="0" cy="0" r="7.4" fill="#FFFFFF"/><circle cx="0" cy="0" r="2.7" fill="#1450A3"/>
          </g>
        </svg>
      </div>
      <div>
        <div class="nm">{SKILL.identidad.nombre}</div>
        <div class="st" id="p-estado">en línea</div>
      </div>
      <button class="x" id="cerrar" aria-label="Cerrar">×</button>
    </div>
    <div class="pasos" id="pasos" title="Progreso del diagnóstico">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="msgs" id="mensajes" role="log" aria-live="polite" aria-label="Conversación con el agente"></div>
    <div class="quick" id="quick"></div>
    <button class="pdfbtn" id="pdfbtn">⬇ Generar mi brief en PDF</button>
    <div class="p-input">
      <textarea id="entrada" rows="1" placeholder="Escribe aquí…"></textarea>
      <button id="enviar">➤</button>
    </div>
  </div>
  <button class="fab" id="fab" aria-label="Abrir conversación con el agente">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0B1B2B" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <span class="badge" id="fab-badge" style="display:none">1</span>
  </button>
</div>
