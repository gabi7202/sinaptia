---
import '../styles/global.css';
interface P { title: string; description: string }
const { title, description } = Astro.props as P;
import { CONFIG } from '../config.js';

// URL absoluta canónica: urlPublica configurada > Astro.site + base > origen relativo
const base = import.meta.env.BASE_URL || '/';
const origen = CONFIG.urlPublica
  || (Astro.site ? String(Astro.site).replace(/\/$/, '') + base : '');
const ruta = Astro.url.pathname;                       // p.ej. /privacidad/
const urlAbsoluta = origen ? origen.replace(/\/$/, '') + ruta : ruta;
const hayOrigen = !!origen;
const ogImg = (origen ? origen.replace(/\/$/, '') : '') + base + 'og.png';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': (origen || '/') + '#organizacion',
      name: 'SINAPTIA',
      slogan: 'IA que entra en operación',
      url: origen || undefined,
      logo: origen ? ogImg : undefined,
      contactPoint: { '@type': 'ContactPoint', telephone: '+529834066179', contactType: 'sales', availableLanguage: ['Spanish', 'English', 'Portuguese'] },
      // dirección en formato SEO local: PostalAddress completo + coordenadas (misma fuente que el footer, NAP consistente)
      address: {
        '@type': 'PostalAddress',
        addressLocality: CONFIG.marca.direccion.localidad,
        addressRegion: CONFIG.marca.direccion.region,
        postalCode: CONFIG.marca.direccion.cp,
        addressCountry: CONFIG.marca.direccion.pais,
      },
      geo: { '@type': 'GeoCoordinates', latitude: CONFIG.marca.direccion.geo.lat, longitude: CONFIG.marca.direccion.geo.lng },
      areaServed: { '@type': 'Place', name: 'Worldwide' },
    },
    {
      '@type': 'Service',
      '@id': (origen || '/') + '#servicio',
      serviceType: 'Implementación de inteligencia artificial para empresas',
      provider: { '@id': (origen || '/') + '#organizacion' },
      areaServed: 'Worldwide',
      description: 'Diagnóstico de automatización con IA y una automatización real en producción dentro de la primera fase, para empresas medianas, emprendedores y startups.',
      // sin `offers`/price: decisión de marca = cero precios visibles (también para crawlers)
    },
    {
      '@type': 'WebSite',
      '@id': (origen || '/') + '#sitio',
      url: origen || '/',
      name: 'SINAPTIA',
      inLanguage: ['es', 'en', 'pt'],
      publisher: { '@id': (origen || '/') + '#organizacion' },
    },
  ],
});
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {hayOrigen && <meta property="og:url" content={urlAbsoluta} />}
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sinaptia — diagnóstico de IA y una automatización real en producción en tu operación" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:locale:alternate" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />
    {hayOrigen && <link rel="canonical" href={urlAbsoluta} />}
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <slot />
  </body>
</html>
