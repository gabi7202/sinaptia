---
import '../styles/global.css';
interface P {
  title: string;
  description: string;
  lang?: 'es' | 'en' | 'pt';
  locale?: string;
  alternates?: boolean;
}
const { title, description, lang = 'es', locale, alternates = true } = Astro.props as P;
import { CONFIG } from '../config.js';

// URL absoluta canónica: urlPublica configurada > Astro.site + base > origen relativo
const base = import.meta.env.BASE_URL || '/';
const origen = CONFIG.urlPublica
  || (Astro.site ? String(Astro.site).replace(/\/$/, '') + base : '');
const ruta = Astro.url.pathname;                       // p.ej. /privacidad/
const urlAbsoluta = origen ? origen.replace(/\/$/, '') + ruta : ruta;
const hayOrigen = !!origen;
// og:image vive en la raíz del sitio, no en la ruta actual (/en/og.png no existe).
let origenAbs = '';
try { origenAbs = origen ? new URL(origen).origin : ''; } catch (e) { origenAbs = ''; }
const ogImg = origenAbs + base + 'og.png';

const LOCALES = { es: 'es_ES', en: 'en_US', pt: 'pt_BR' };
const LOCALE = locale || LOCALES[lang] || 'es_ES';

// hreflang solo tiene sentido con URL absoluta. Las dos rutas existen: / y /en/.
const raiz = origen ? origen.replace(/\/$/, '') : '';
const rutaEs = raiz + (base === '/' ? '/' : base.replace(/\/$/, '') + '/');
const rutaEn = rutaEs.replace(/\/$/, '') + '/en/';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': (origen || '/') + '#organizacion',
      name: 'SINAPTIA',
      slogan: 'IA que entra en operación',
      url: origen || undefined,
      logo: origen ? ogImg : undefined,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: CONFIG.marca.whatsapp,
        contactType: 'sales',
        url: CONFIG.marca.whatsappUrl,
        availableLanguage: ['Spanish', 'English', 'Portuguese'],
      },
    },
    {
      '@type': 'Service',
      '@id': (origen || '/') + '#servicio',
      serviceType: 'Implementación de inteligencia artificial para empresas',
      provider: { '@id': (origen || '/') + '#organizacion' },
      areaServed: 'Worldwide',
      description: 'Diagnóstico de automatización con IA y una automatización real en producción dentro de la primera fase, para empresas medianas, emprendedores y startups.',
      offers: { '@type': 'Offer', name: 'Diagnóstico de IA + piloto en la primera fase', price: '1800', priceCurrency: 'USD' },
    },
    {
      '@type': 'WebSite',
      '@id': (origen || '/') + '#sitio',
      url: origen || '/',
      name: 'SINAPTIA',
      inLanguage: ['es', 'en', 'pt'],
      publisher: { '@id': (origen || '/') + '#organizacion' },
    },
  ],
});
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {hayOrigen && <meta property="og:url" content={urlAbsoluta} />}
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sinaptia — diagnóstico de IA y una automatización real en producción en tu operación" />
    <meta property="og:locale" content={LOCALE} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />
    {hayOrigen && <link rel="canonical" href={urlAbsoluta} />}
    {hayOrigen && alternates && <link rel="alternate" hreflang="es" href={rutaEs} />}
    {hayOrigen && alternates && <link rel="alternate" hreflang="en" href={rutaEn} />}
    {hayOrigen && alternates && <link rel="alternate" hreflang="x-default" href={lang === 'en' ? rutaEn : rutaEs} />}
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <slot />
  </body>
</html>
