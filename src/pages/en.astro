---
/**
 * /en — La puerta para el prospecto que paga en inglés.
 *
 * No es una traducción automática del sitio español: es una landing propia,
 * escrita en inglés de negocios, con la misma promesa (diagnóstico + piloto real)
 * y una sección de transparencia explícita sobre la IA y el intérprete.
 */
import Base from '../layouts/Base.astro';
import { CONFIG } from '../config.js';
---
<Base
  title="SINAPTIA — AI that goes into production, not another chatbot demo"
  description="Sinaptia diagnoses one process worth automating in your small or mid-sized business, tells you what not to automate, and leaves you a one-page project brief."
  lang="en"
>
  <style>
    .en-hero{padding:60px 0 54px;background:linear-gradient(180deg,#fff,var(--fondo) 75%)}
    .en-hero h1{font-size:clamp(31px,4.7vw,54px);max-width:900px;margin-bottom:18px}
    .en-hero .hero-sub{max-width:680px;font-size:17.5px}
    .en-proof{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
    .en-proof span{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;
      background:var(--blanco);border:1px solid var(--borde);border-radius:99px;padding:8px 13px;color:var(--tinta3)}
    .en-two{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:start}
    .en-op{background:var(--blanco);border:1px solid var(--borde);border-radius:14px;padding:16px 18px;box-shadow:var(--sombra);margin-bottom:12px}
    .en-op b{color:var(--tinta);display:block;margin-bottom:3px}
    .en-op p{font-size:13.5px}
    .en-price{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:24px}
    .en-price .card{padding:20px}
    .en-price .k{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--azul);font-weight:700}
    .en-price .v{font-size:23px;font-weight:700;color:var(--tinta);letter-spacing:-.03em;margin:8px 0 4px}
    .en-band{background:#0E1B2A;color:#DCE9F7;border-radius:16px;padding:28px 30px;margin-top:26px}
    .en-band h2{color:#fff;font-size:23px;margin-bottom:10px}
    .en-band p{color:#B9CCE0;max-width:850px;font-size:14.5px}
    .en-band a{color:#8DC8FF}
    .en-faq details{background:var(--blanco);border:1px solid var(--borde);border-radius:12px;padding:16px 18px;margin-bottom:10px}
    .en-faq summary{cursor:pointer;font-weight:700;color:var(--tinta);font-size:15px}
    .en-faq p{margin-top:9px;font-size:14px}
    .en-chat{background:var(--blanco);border:1px solid var(--borde);border-radius:16px;box-shadow:var(--sombra-alta);
      overflow:hidden;max-width:820px;margin:0 auto}
    .en-head{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--borde)}
    .en-dot{width:9px;height:9px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 4px #0478571f}
    .en-head b{font-size:14px;color:var(--tinta)}
    .en-head span{font-size:11.5px;color:var(--tinta3);margin-left:auto}
    .en-msgs{height:330px;overflow:auto;padding:18px;display:flex;flex-direction:column;gap:9px;background:var(--fondo)}
    .en-msg{max-width:86%;padding:10px 13px;border-radius:12px;font-size:14px;line-height:1.55;white-space:pre-wrap}
    .en-msg.bot{background:var(--blanco);border:1px solid var(--borde);color:var(--tinta)}
    .en-msg.user{align-self:flex-end;background:var(--azul);color:#fff}
    .en-msg.sys{align-self:center;background:var(--azul-suave);border:1px solid var(--azul-borde);color:var(--azul-osc);font-size:12px;text-align:center}
    .en-quick{display:flex;gap:7px;flex-wrap:wrap;padding:0 18px 10px;background:var(--fondo)}
    .en-quick button{font:inherit;font-size:12px;border:1px solid var(--azul-borde);background:var(--blanco);color:var(--azul-osc);
      border-radius:99px;padding:6px 11px;cursor:pointer}
    .en-input{display:flex;gap:8px;padding:12px 14px;border-top:1px solid var(--borde);background:var(--blanco)}
    .en-input textarea{flex:1;resize:none;border:1px solid var(--borde);border-radius:9px;padding:10px 12px;font:inherit;font-size:14px;
      background:var(--fondo);color:var(--tinta);outline:none}
    .en-input button{border:none;background:var(--azul);color:#fff;font-weight:700;border-radius:9px;padding:0 18px;cursor:pointer;font:inherit}
    .en-status{font-size:11.5px;color:var(--tinta3);padding:0 18px 12px;min-height:18px;background:var(--blanco)}
    .en-pdf{display:none;margin:0 18px 12px;background:var(--blanco);border:1px dashed var(--azul-borde);border-radius:10px;padding:12px;text-align:center}
    .en-pdf button{font:inherit;font-weight:700;background:var(--azul);color:#fff;border:none;border-radius:8px;padding:9px 16px;cursor:pointer}
    @media(max-width:860px){.en-two,.en-price{grid-template-columns:1fr}.en-price{grid-template-columns:1fr 1fr}}
  </style>

  <nav class="nav">
    <div class="nav-in">
      <a class="brand" href="/en/">
        <svg width="26" height="26" viewBox="0 0 40 40" aria-hidden="true">
          <g transform="translate(20,21)">
            <path d="M0 0 L-11 -11" stroke="#1450A3" stroke-width="3.4" stroke-linecap="round"/>
            <path d="M0 0 L12 -9" stroke="#1450A3" stroke-width="3.4" stroke-linecap="round"/>
            <path d="M0 0 L0 12" stroke="#1D6FE0" stroke-width="3.4" stroke-linecap="round"/>
            <circle cx="-11" cy="-11" r="3.4" fill="#1450A3"/><circle cx="12" cy="-9" r="3.4" fill="#1450A3"/>
            <circle cx="0" cy="12" r="3.8" fill="#1D6FE0"/><circle cx="0" cy="0" r="6.4" fill="#1D6FE0"/>
            <circle cx="0" cy="0" r="2.3" fill="#F4F7F9"/>
          </g>
        </svg>
        <span>{CONFIG.marca.nombre}</span>
      </a>
      <a href="/" style="margin-left:auto;font-family:var(--mono);font-size:11px;font-weight:700;color:var(--tinta3);text-decoration:none">ES</a>
      <a class="nav-cta" href="#talk" style="text-decoration:none">Talk to Nexa</a>
    </div>
  </nav>

  <header class="en-hero">
    <div class="wrap">
      <div class="eyebrow"><i></i> built for small and mid-sized businesses</div>
      <h1>AI that goes into production.<br />Not another chatbot demo.</h1>
      <p class="hero-sub">Sinaptia finds <b>one process that costs you time or money</b>, maps it, simplifies it
        and puts a real first automation into production inside the first phase. You leave with a
        one-page project brief — including what you should <b>not</b> automate.</p>
      <div class="cta-row">
        <a class="btn p" href="#talk">Start the diagnosis</a>
        <a class="btn s" href={CONFIG.marca.whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn s" href="#how">See how it works</a>
        <a class="btn s" href="/voz/?lang=en">Talk by voice</a>
      </div>
      <div class="en-proof">
        <span>5–200 employees</span><span>One process, real pilot</span>
        <span>Human approval on money</span><span>English · Spanish · Portuguese</span>
      </div>
    </div>
  </header>

  <section class="alt" id="problem">
    <div class="wrap en-two">
      <div>
        <div class="eyebrow"><i></i> the real problem</div>
        <h2 class="sec-title">You are not losing to competitors. You are losing to response time.</h2>
        <p class="sec-lead">Quotes answered tomorrow. Enquiries that never get a reply. Reports rebuilt by hand
          every month. The work is not hard — there is just too much of it for the team you have.</p>
        <p class="sec-lead" style="margin-top:12px">Buying “AI” does not fix that. Mapping the process, removing
          the steps that should not exist, and automating only what is left does.</p>
      </div>
      <div>
        <div class="en-op"><b>Leads go cold before someone answers</b><p>The prospect buys from whoever replies first, not whoever is best.</p></div>
        <div class="en-op"><b>Quotes take hours of copying and checking</b><p>Your best people spend the day on work a system should prepare.</p></div>
        <div class="en-op"><b>Nobody trusts the numbers</b><p>Five spreadsheets, three versions of the truth, and a monthly argument.</p></div>
      </div>
    </div>
  </section>

  <section id="what">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow"><i></i> what we build</div>
        <h2 class="sec-title">Four builds. One at a time, in production.</h2>
        <p class="sec-lead">Every build starts with a diagnosis. If the numbers do not justify it, we tell you
          before you spend.</p>
      </div>
      <div class="grid3">
        <article class="card"><div class="num">01 · FRONT OFFICE</div><h3>Immediate-response agent</h3>
          <p>Answers enquiries on web and WhatsApp in seconds, uses your real catalogue and policies, qualifies
            the lead and books a call. A human takes over for negotiation.</p></article>
        <article class="card"><div class="num">02 · BACK OFFICE</div><h3>Documents and quotes</h3>
          <p>Reads incoming documents, extracts and validates the data against your masters, drafts the quote
            inside your policy, and routes anything above a threshold to a person.</p></article>
        <article class="card"><div class="num">03 · DATA</div><h3>Reports you can trust</h3>
          <p>One source of truth across your systems, scheduled reports, and alerts when a number moves for a
            reason nobody can explain.</p></article>
        <article class="card"><div class="num">04 · INTERNAL</div><h3>Team copilot</h3>
          <p>Answers your team’s questions from your policies and manuals, cites the source, and logs the
            questions it could not answer — so you know what documentation is missing.</p></article>
      </div>
    </div>
  </section>

  <section class="alt" id="how">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow"><i></i> how it works</div>
        <h2 class="sec-title">Map. Simplify. Automate. Measure.</h2>
      </div>
      <div class="steps4">
        <div class="step"><span class="n">01</span><h4>Diagnosis</h4><p>We review your process, the volume, the tools and the cost of the current way. One process, scored by impact and feasibility.</p></div>
        <div class="step"><span class="n">02</span><h4>Simplify first</h4><p>We remove steps before automating them. Automating a broken process only produces faster mistakes.</p></div>
        <div class="step"><span class="n">03</span><h4>Real pilot</h4><p>One piece running in production, with human approval where money or legal risk is involved.</p></div>
        <div class="step"><span class="n">04</span><h4>Measure and decide</h4><p>We compare the result with the baseline. If it works, we expand. If it does not, we say so.</p></div>
      </div>
    </div>
  </section>

  <section id="pricing">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow"><i></i> honest ranges</div>
        <h2 class="sec-title">What it costs, before you get on a call.</h2>
        <p class="sec-lead">The exact number comes from your process, not from a menu. These are the ranges we
          work with so you can decide whether a conversation is worth your time.</p>
      </div>
      <div class="en-price">
        <div class="card"><div class="k">Diagnosis + pilot</div><div class="v">$1,800</div><p>Fixed. Credited against the next project if you continue.</p></div>
        <div class="card"><div class="k">Agent / automation</div><div class="v">from $3,500</div><p>Depending on channels, integrations and volume.</p></div>
        <div class="card"><div class="k">Custom application</div><div class="v">from $8,000</div><p>When the process needs its own product, not a connector.</p></div>
        <div class="card"><div class="k">Optional monthly care</div><div class="v">from $900</div><p>Monitoring, improvements and support after launch.</p></div>
      </div>
    </div>
  </section>

  <section class="alt" id="transparency">
    <div class="wrap">
      <div class="en-band">
        <div class="eyebrow" style="color:#8DC8FF"><i></i> transparency</div>
        <h2>You are talking to an AI. The human behind it does not speak fluent English.</h2>
        <p>Nexa is Sinaptia’s AI assistant. The founder is a real person who uses AI to work with clients in
          English, because we would rather build the bridge than pretend the barrier is not there. If you
          prefer a video call, we run it with <b>live AI interpretation both ways</b>: you speak English and he
          reads Spanish; he speaks Spanish and you read English. You can try the interpreter
          <a href="/interprete">here</a>. No pretending, no fake “our team” — one AI, one human, and written
          follow-ups in your language.</p>
      </div>
    </div>
  </section>

  <section id="talk">
    <div class="wrap">
      <div class="sec-head" style="text-align:center;margin-left:auto;margin-right:auto">
        <div class="eyebrow" style="justify-content:center"><i></i> the diagnosis</div>
        <h2 class="sec-title">Tell Nexa what your business does.</h2>
        <p class="sec-lead" style="margin-left:auto;margin-right:auto">A few questions. One process. A brief you can
          send to whoever decides with you. If AI is not the answer, she will say so.</p>
      </div>
      <div class="en-chat">
        <div class="en-head"><span class="en-dot"></span><b>Nexa</b><span>AI assistant · Sinaptia</span></div>
        <div class="en-msgs" id="en-msgs" role="log" aria-live="polite" aria-label="Conversation with Nexa"></div>
        <div class="en-quick" id="en-quick"></div>
        <div class="en-pdf" id="en-pdf"><button type="button" id="en-pdf-btn">Download my project brief (PDF)</button></div>
        <div class="en-input">
          <textarea id="en-input" rows="1" placeholder="Type your answer…" aria-label="Your message"></textarea>
          <button type="button" id="en-send">Send</button>
        </div>
        <div class="en-status" id="en-status">Nexa is an AI. A copy of your brief can be sent to the Sinaptia team.</div>
      </div>
    </div>
  </section>

  <section class="alt" id="faq">
    <div class="wrap wrap-narrow">
      <div class="sec-head"><div class="eyebrow"><i></i> straight answers</div><h2 class="sec-title">Questions we get before the first call.</h2></div>
      <div class="en-faq">
        <details open><summary>Do you replace my team?</summary><p>No. We remove repetitive tasks. Your team keeps negotiating, deciding and caring for clients. Any project that promises to replace people is a project that gets cancelled.</p></details>
        <details><summary>Can the system make mistakes?</summary><p>Yes. Models are probabilistic. We bound the error with validations, human approval where money or legal risk is involved, and a log of every decision. Anyone promising 100% accuracy is selling you something else.</p></details>
        <details><summary>Do you train a model on my data?</summary><p>Almost never. We use retrieval over your documents (RAG), so the system consults and cites your information. It is cheaper, safer and updates when you edit the document.</p></details>
        <details><summary>How do we communicate if I only speak English?</summary><p>Nexa speaks native business English. For calls, we use live AI interpretation both ways and confirm the important parts in writing. It is slower than a human interpreter and far cheaper than misunderstanding each other.</p></details>
        <details><summary>What happens to my data?</summary><p>It is used to answer you and prepare your brief, not to train third-party models. We sign confidentiality and data-processing agreements before touching production systems.</p></details>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap footer-in">
      <span>{CONFIG.marca.nombre} · AI that goes into production</span>
      <span><a href="/">Español</a> · <a href="/en/privacy/">Privacy</a> · <a href={CONFIG.marca.whatsappUrl} target="_blank" rel="noopener">WhatsApp {CONFIG.marca.whatsapp}</a> · {CONFIG.marca.web}</span>
    </div>
  </footer>

  <script>
    import { CONFIG } from '../config.js';
    import { packPor } from '../lib/i18n.js';
    import { crearAgente } from '../lib/engine.js';
    import { responderTurno, textoRetoma } from '../lib/conversacion.js';
    import { MemoriaSesion } from '../lib/memoriaSesion.js';
    import { crearBrief } from '../lib/brief.js';
    import { enviarCopia, compartirPdf, whatsappCopia, abrirWhatsApp } from '../lib/proyecto.js';

    const $ = (id) => document.getElementById(id);
    const pack = packPor('en');
    const ctx = { ciudad: '', pais: '', temp: null, clima: '', hora: '', saludo: '', tipKey: 'nublado', dispositivo: 'web', canal: 'en-web' };
    let agente = crearAgente(pack, ctx);
    agente.iniciar();
    const memory = new MemoriaSesion({
      idioma: 'en',
      horas: (CONFIG.memoria && CONFIG.memoria.horas) || 12,
      maxTurnos: (CONFIG.memoria && CONFIG.memoria.maxTurnos) || 40,
    });
    let historial = [];
    let ocupado = false;

    const INTRO = "Hi, I'm Nexa, Sinaptia's AI assistant. One question to start: what does your business do?";
    const RX_RESET = /^(start over|clear memory|start again|reset)\b/i;

    function add(rol, texto) {
      const d = document.createElement('div');
      d.className = 'en-msg ' + rol;
      d.textContent = texto;
      $('en-msgs').appendChild(d);
      $('en-msgs').scrollTop = $('en-msgs').scrollHeight;
      return d;
    }
    function quick(items) {
      const q = $('en-quick');
      q.innerHTML = '';
      for (const t of items || []) {
        const b = document.createElement('button');
        b.type = 'button'; b.textContent = t;
        b.addEventListener('click', () => enviar(t));
        q.appendChild(b);
      }
    }
    function status(t) { $('en-status').textContent = t; }

    function reiniciar() {
      memory.borrar();
      historial = [];
      agente = crearAgente(pack, ctx);
      agente.iniciar();
      $('en-msgs').innerHTML = '';
      $('en-pdf').style.display = 'none';
      add('bot', INTRO);
      quick(['We sell auto parts', 'We run a clinic', 'Software for logistics']);
      status('Memory cleared. Starting from scratch.');
    }

    function retomar() {
      if (!memory.tamano) return false;
      memory.reproducir(agente);
      historial = memory.historial(20);
      add('sys', textoRetoma('en', memory.contexto()));
      quick([]);
      return true;
    }

    async function enviar(texto) {
      const t = String(texto == null ? $('en-input').value : texto).trim();
      if (!t || ocupado) return;
      if (RX_RESET.test(t)) { $('en-input').value = ''; reiniciar(); return; }
      ocupado = true;
      $('en-input').value = '';
      add('user', t);
      memory.agregar('user', t);
      historial.push({ role: 'user', content: t });
      status('Nexa is thinking…');
      try {
        const r = await responderTurno({
          texto: t, canal: 'chat', idioma: 'en', historial: historial.slice(0, -1),
          memoria: memory.contexto(), agente,
          endpoint: CONFIG.ia && CONFIG.ia.endpoint,
          timeoutMs: (CONFIG.ia && CONFIG.ia.timeoutMs) || 12000,
        });
        add('bot', r.texto);
        memory.agregar('bot', r.texto);
        memory.guardarLead(agente.lead);
        historial.push({ role: 'assistant', content: r.texto });
        status(r.modo === 'ia' ? 'Nexa · AI' : 'Nexa · local engine');
        if (r.listoParaPdf) {
          $('en-pdf').style.display = 'block';
          quick([]);
        } else if (agente.estado.etapa === 'sector') {
          quick(['We sell auto parts', 'We run a clinic', 'Software for logistics']);
        } else if (agente.estado.etapa === 'volumen') {
          quick(['About 300 a month', 'I do not know']);
        } else if (agente.estado.etapa === 'propuesta' || agente.estado.etapa === 'pdf_ofrecido') {
          quick(['Yes, send the PDF', 'Not now']);
        }
      } catch (e) {
        add('sys', 'Something went wrong. Your conversation is still stored in this browser; try again.');
      } finally {
        ocupado = false;
        $('en-input').focus();
      }
    }

    async function descargar() {
      try {
        const { doc, nombre, proyecto } = crearBrief({
          lead: agente.lead, estado: agente.estado, ctx, pack, memoria: memory, config: CONFIG,
        });
        doc.descargar(nombre);
        add('sys', 'Your brief is downloaded. Sending a copy to the Sinaptia team…');
        const bytes = doc.bytes();
        const r = await enviarCopia({
          endpoint: CONFIG.proyecto && CONFIG.proyecto.endpoint,
          proyecto, bytes,
        });
        if (r && r.enviado) add('sys', 'Copy sent to the Sinaptia team. You will get a reply in English.');
        else {
          add('sys', 'The PDF is on your device. Automatic delivery is not configured, so use Share or WhatsApp below.');
          const bar = document.createElement('div');
          bar.style.cssText = 'display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:8px';
          const share = document.createElement('button');
          share.type = 'button'; share.textContent = 'Share PDF';
          share.style.cssText = 'font:inherit;font-size:12px;font-weight:700;padding:7px 12px;border-radius:99px;border:1px solid var(--azul-borde);background:var(--azul-suave);color:var(--azul-osc);cursor:pointer';
          share.addEventListener('click', async () => {
            const ok = await compartirPdf(bytes, nombre, 'Sinaptia · ' + proyecto.id);
            if (!ok) abrirWhatsApp(whatsappCopia(proyecto, CONFIG.marca.whatsappNumero, 'en'));
          });
          const wa = document.createElement('button');
          wa.type = 'button'; wa.textContent = 'WhatsApp';
          wa.style.cssText = share.style.cssText;
          wa.addEventListener('click', () => abrirWhatsApp(whatsappCopia(proyecto, CONFIG.marca.whatsappNumero, 'en')));
          bar.appendChild(share); bar.appendChild(wa);
          $('en-msgs').appendChild(bar);
          $('en-msgs').scrollTop = $('en-msgs').scrollHeight;
        }
      } catch (e) {
        add('sys', 'I could not generate the PDF in this browser. The conversation is still saved here.');
      }
    }

    $('en-send').addEventListener('click', () => enviar());
    $('en-input').addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); enviar(); }
    });
    $('en-pdf-btn').addEventListener('click', descargar);

    if (!retomar()) {
      add('bot', INTRO);
      quick(['We sell auto parts', 'We run a clinic', 'Software for logistics']);
    }
  </script>
</Base>
