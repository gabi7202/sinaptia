---
import Base from '../layouts/Base.astro';
---
<Base title="No encontramos esto — SINAPTIA" description="Página no encontrada.">
  <main class="wrap" style="padding:96px 26px;text-align:center">
    <div class="eyebrow" style="justify-content:center"><i></i> 404</div>
    <h1 class="sec-title">Esta página no existe,<br />pero el agente sí.</h1>
    <p class="sec-lead" style="margin:14px auto 28px">Si buscabas algo concreto, pregúntaselo directamente: responde en segundos y te lleva a lo que necesitas.</p>
    <a class="btn p" href="/">Volver al inicio y hablar con el agente</a>
  </main>
</Base>
